<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>Music API</title>
    <script>
        // Get query parameters
        const params = new URLSearchParams(window.location.search);
        const player = params.get('player');
        const version = params.get('version');
        const from = params.get('from');
        
        // Validate request
        if (player === 'v2/play/musicplayer' && 
            version === 'v2/play' && 
            from === 'assets-uxidone.github.io/assets/music/putvejini') {
            
            // Redirect to actual music file
            window.location.replace('/assets/music/putvejini.mp3');
        } else {
            document.body.innerHTML = `
                <h1>400 Bad Request</h1>
                <p>Invalid parameters. Required format:</p>
                <pre>
api-uxidone.github.io/api/music?player=v2/play/musicplayer
&version=v2/play
&from=assets-uxidone.github.io/assets/music/putvejini
                </pre>
            `;
        }
    </script>
</head>
<body>
    Loading music player...
</body>
</html>
